# ── App ────────────────────────────────────────────────────────────────────
DEBUG=true

# ── Face recognition ────────────────────────────────────────────────────────
# Euclidean distance threshold (0.0–1.0). Lower = stricter matching.
FACE_MATCH_TOLERANCE=0.55

# ── Liveness ────────────────────────────────────────────────────────────────
# Set to "false" in development to skip the liveness token check.
LIVENESS_ENABLED=true

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your Laravel app's URL).
ALLOWED_ORIGINS=http://localhost:8000,http://localhost
